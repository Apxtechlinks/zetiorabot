# Public values: provide BEFORE building, and use the same backend as the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only values for YOUR independently owned backend (not Lovable Cloud).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Single service: the WhatsApp worker runs inside the same container.
# Leave WHATSAPP_WORKER_URL empty (defaults to http://127.0.0.1:8088).
WHATSAPP_WORKER_URL=
# Any long random string; shared automatically with the built-in worker.
WHATSAPP_WORKER_TOKEN=
# WhatsApp session storage. Mount a Railway volume at /data.
SESSIONS_DIR=/data/sessions

# Obtain your own Gemini key. Never give any secret a VITE_ prefix.
GEMINI_API_KEY=
# Set to a model available to your key; overrides the app's legacy default.
GEMINI_MODEL=gemini-2.5-flash

# Railway injects PORT; do not hardcode it. For local use only: PORT=3000
NODE_ENV=production