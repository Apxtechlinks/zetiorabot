# Port this service listens on
PORT=8088

# Shared token. Must be EXACTLY the same value as the WHATSAPP_WORKER_TOKEN
# saved inside the app.
WORKER_TOKEN=replace-with-your-token

# Where this service posts incoming messages and connection changes.
# Use your app address, no trailing slash.
APP_URL=https://your-app-domain.up.railway.app

# Folder where WhatsApp login sessions are stored (keep it, or you must scan again)
SESSIONS_DIR=/data/sessions
